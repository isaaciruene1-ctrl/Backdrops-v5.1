                <action android:name="com.example.widget.ACTION_APPLY_NEXT" />
                <action android:name="com.example.widget.ACTION_NEXT_WALLPAPER" />
                <action android:name="com.example.widget.ACTION_APPLY_CURRENT" />
                <action android:name="com.example.widget.ACTION_TOGGLE_FAVORITE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_backdrop_switcher_info" />
